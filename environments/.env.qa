# QA environment.
# SauceDemo only has one public site, so this points at the same URL as .env.demo. It is here to
# show the pattern: on a real project this file holds the QA base URL, and the credentials stay
# in a git-ignored environments/.env.local or in pipeline secrets.
# Run it with: TEST_ENV=qa npm test
BASE_URL=https://www.saucedemo.com
APP_USERNAME=standard_user
APP_PASSWORD=secret_sauce
